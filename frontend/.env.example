# ADMIN — from env vars, password as bcrypt hash not plaintext hardcoded
# Generate hash: node -e "console.log(require('bcryptjs').hashSync('yourpassword',10))"
# Escape $ as \$ in .env file for dotenv-expand
# SECURITY WARNING: admin123 hash below is WEAK DEFAULT for local dev only — MUST change to strong unique password before ANY public deployment
# How to change: just env var swap, no code change — generate new hash and set ADMIN_PASSWORD_HASH
# Example strong: node -e "console.log(require('bcryptjs').hashSync('YOUR_STRONG_32+_CHARS_RANDOM',10))"
ADMIN_EMAIL=admin@spi.learning
ADMIN_PASSWORD_HASH=\$2b\$10\$wvbKSQ.mToYucEsowfeHRepfjVsrgKeLjOb9ahvbWan5kisR6g/FS
ADMIN_TOKEN=spi_admin_secret_2024_secure_env_test_CHANGE_BEFORE_PROD

# DATABASE — SQLite for now (data/spi.db), ephemeral on Render/Vercel/Railway — will lose data on every deploy
# For future Postgres migration (Supabase/Neon free tier), set DATABASE_URL — config change not rewrite, pending
# DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
# UNVERIFIED: Real YouTube transcript extraction pending real internet test — sandbox blocks YouTube, honest no-fake proven but real extraction not verified yet, requires deploy to Vercel/Render with real internet

# Google OAuth — free, any volume, no billing
# Get from console.cloud.google.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# CORE NOTES AI — 100% FREE — Gemini primary, Groq fallback, no Claude, no Puter.js for core notes
# PRIMARY: Google Gemini free tier — gemini-1.5-flash (1M context, largest free tier, 15 RPM 1M TPM) — FREE no credit card
# Get free key: https://aistudio.google.com/apikey — no credit card required, 15 RPM, 1M context window
# GEMINI_API_KEY is the ONLY key required for entire notes pipeline to work at full quality — 100% free, zero paid dependency
GEMINI_API_KEY=your-gemini-free-key-from-aistudio-googleapis
GEMINI_MODEL=gemini-1.5-flash

# FALLBACK: Groq free tier — llama-3.3-70b-versatile (or 3.1-70b) — FREE no credit card, open-weight models
# Get free key: https://console.groq.com/keys — no credit card, 14.4k requests/day, 30 RPM
# Used when Gemini rate-limited/down, same meticulous prompt, no third-party proxy
GROQ_API_KEY=your-groq-free-key
GROQ_MODEL=llama-3.3-70b-versatile

# OPTIONAL ADD-ON (OFF by default, not required, not used): Claude — only if someone explicitly wants it later
# ANTHROPIC_API_KEY=your-anthropic-key-optional-not-required
# CLAUDE_MODEL=claude-3-5-sonnet-20241022
